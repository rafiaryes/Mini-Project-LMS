# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lms_dev

# ── Session ───────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-secret

# ── API Server ────────────────────────────────────────────
API_PORT=3001

# ── Frontend Origin (for CORS) ────────────────────────────
WEB_ORIGIN=http://localhost:3000

# ── File Uploads ──────────────────────────────────────────
UPLOAD_MAX_BYTES=10485760
UPLOAD_DIR=./uploads

# ── Environment ───────────────────────────────────────────
NODE_ENV=development

# ── Initial Admin Seed (Optional) ──────────────────────────
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@lms.local
ADMIN_PASSWORD=Admin123!

